SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-01

# Shopify Customer Account API (OAuth / PKCE)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://shopgodsown.com/api/auth/callback
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SHOP_ID=your_shopify_shop_id
NEXT_PUBLIC_SHOPIFY_SHOP_ID=your_shopify_shop_id
NEXT_PUBLIC_SHOPIFY_SUBCHANNEL_ID=your_headless_subchannel_or_publication_id

# Meta Pixel & Conversions API
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_CONVERSIONS_API_ACCESS_TOKEN=your_meta_capi_access_token
META_API_VERSION=v20.0
# META_TEST_EVENT_CODE=TEST12345
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_or_client_secret